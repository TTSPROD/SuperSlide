{
  "$defs": {
    "SourceChartData": {
      "additionalProperties": false,
      "properties": {
        "categories": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Categories",
          "type": "array"
        },
        "series": {
          "items": {
            "$ref": "#/$defs/SourceChartSeries"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Series",
          "type": "array"
        }
      },
      "required": [
        "categories",
        "series"
      ],
      "title": "SourceChartData",
      "type": "object"
    },
    "SourceChartSeries": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 150,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "name",
        "values"
      ],
      "title": "SourceChartSeries",
      "type": "object"
    },
    "SourceSlide": {
      "additionalProperties": false,
      "properties": {
        "layout_id": {
          "enum": [
            "title",
            "contents",
            "separators",
            "big_text",
            "bullets",
            "cards",
            "tables",
            "diagram",
            "schemes",
            "circle_schemes",
            "team",
            "photo",
            "quotes",
            "icons",
            "last_slide"
          ],
          "title": "Layout Id",
          "type": "string"
        },
        "variant_id": {
          "pattern": "^slide_[0-9]{3}$",
          "title": "Variant Id",
          "type": "string"
        },
        "updates": {
          "items": {
            "$ref": "#/$defs/SourceUpdate"
          },
          "maxItems": 250,
          "title": "Updates",
          "type": "array"
        },
        "source_refs": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "title": "Source Refs",
          "type": "array"
        },
        "notes": {
          "default": "",
          "maxLength": 3000,
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "layout_id",
        "variant_id"
      ],
      "title": "SourceSlide",
      "type": "object"
    },
    "SourceUpdate": {
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "pattern": "^(slide|layout|master)_(text|table|chart|picture|icon)_[0-9]+$",
          "title": "Field Id",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 12000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "paragraphs": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraphs"
        },
        "rows": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "maxItems": 100,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rows"
        },
        "photo_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Photo Id"
        },
        "icon_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Icon Id"
        },
        "chart_data": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceChartData"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "field_id"
      ],
      "title": "SourceUpdate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "template_version": {
      "const": "2.0",
      "title": "Template Version",
      "type": "string"
    },
    "title": {
      "maxLength": 150,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "slides": {
      "items": {
        "$ref": "#/$defs/SourceSlide"
      },
      "maxItems": 250,
      "minItems": 1,
      "title": "Slides",
      "type": "array"
    }
  },
  "required": [
    "template_version",
    "title",
    "slides"
  ],
  "title": "SourcePresentationSpec",
  "type": "object"
}
